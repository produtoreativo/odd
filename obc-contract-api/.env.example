LANGSMITH_API_KEY=

# LangSmith defaults opcionais
# LANGSMITH_PROJECT=obc-contract-api
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Credenciais podem vir do ambiente, perfil AWS ou role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
BEDROCK_REQUEST_TIMEOUT_MS=3600000

# Modelo padrão e por agente (CLI --model / --identify-model têm precedência).
OBC_CONTRACT_DEFAULT_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
OBC_CONTRACT_IDENTIFY_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
